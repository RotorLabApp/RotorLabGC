// RotorLab: A177 - configured by CMakeLists.txt (configure_file) into the build tree and
// compiled into the exe. It carries the icon and a real VERSIONINFO, so Windows Explorer
// and Authenticode show the version from the git tag (cmake/Git.cmake).
#include "winver.h"

IDI_ICON1 ICON "@QGC_WINDOWS_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @QGC_WINDOWS_VERSION_COMMA@
 PRODUCTVERSION @QGC_WINDOWS_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@QGC_ORG_NAME@"
            VALUE "FileDescription", "@QGC_WINDOWS_PRODUCT_NAME@"
            VALUE "FileVersion", "@QGC_WINDOWS_VERSION_DOT@"
            VALUE "LegalCopyright", "@QGC_APP_COPYRIGHT@"
            VALUE "InternalName", "@CMAKE_PROJECT_NAME@"
            VALUE "OriginalFilename", "@CMAKE_PROJECT_NAME@.exe"
            VALUE "ProductName", "@QGC_WINDOWS_PRODUCT_NAME@"
            VALUE "ProductVersion", "@QGC_WINDOWS_PRODUCT_VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
